<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="privilege_edit_list_header" model="res.groups.privilege">
            <field name="name">Edit List View Header</field>
            <field name="category_id" ref="base.module_category_extra"/>
        </record>

        <record id="group_edit_list_header" model="res.groups">
            <field name="name">Allowed</field>
            <field name="privilege_id" ref="privilege_edit_list_header"/>
            <field name="comment">Members of this group can configure list view merged headers via the UI.</field>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>

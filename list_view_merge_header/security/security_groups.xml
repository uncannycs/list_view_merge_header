<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_list_view_merge_header" model="ir.module.category">
            <field name="name">List View Merge Header</field>
            <field name="description">Manage merged header configurations for list views.</field>
            <field name="sequence">100</field>
            <field name="visible">True</field>
        </record>

        <record id="group_edit_list_header" model="res.groups">

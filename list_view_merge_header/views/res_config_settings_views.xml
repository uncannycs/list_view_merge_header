<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="list_view_header_config_view_tree" model="ir.ui.view">
        <field name="name">list.view.header.config.view.list</field>
        <field name="model">list.view.header.config</field>
        <field name="arch" type="xml">
            <list string="List Header Configurations">
                <field name="name"/>
                <field name="model_name"/>
                <field name="view_id"/>
                <field name="view_key"/>
                <field name="center_headers"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="list_view_header_config_view_form" model="ir.ui.view">
        <field name="name">list.view.header.config.view.form</field>
        <field name="model">list.view.header.config</field>
        <field name="arch" type="xml">
            <form string="List Header Configuration">
                <sheet>
                    <group>
                        <group>
                            <field name="view_id" readonly="1"/>
                            <field name="view_key" readonly="1"/>
                            <field name="model_name" readonly="1"/>
                        </group>
                        <group>
                            <field name="center_headers"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Configuration JSON" name="json_config">
                            <field name="header_config" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_list_view_header_config" model="ir.actions.act_window">
        <field name="name">Merged Header Configurations</field>
        <field name="res_model">list.view.header.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_list_view_header_config"
              name="Merged Header Configurations"
              parent="base.menu_custom"
              action="action_list_view_header_config"
              sequence="100"/>
</odoo>
